{
  "name": "carrydesk-rotate",
  "description": "Execution half of CarryDesk. Webhook receives {state, spread, ema_apr, reference_apr, rotation_count_today, chat_id}. ENTER: idempotency check -> approve DAI (exact amount) -> Spark sDAI vault deposit -> read-back verify. EXIT: get sDAI shares -> redeem -> verify DAI received -> Aave V3 supply -> read-back. Rotation budget: hard cap 1/day.",
  "nodes": [
    {
      "id": "wf2-trigger",
      "type": "trigger",
      "position": {"x": 0, "y": 0},
      "data": {
        "type": "trigger",
        "label": "Rotate Trigger",
        "config": {"triggerType": "Webhook"},
        "status": "idle"
      }
    },
    {
      "id": "budget-code",
      "type": "action",
      "position": {"x": 252, "y": 0},
      "data": {
        "type": "action",
        "label": "Budget Check",
        "config": {
          "code": "const max = 1;\nconst count = parseInt('{{@wf2-trigger:Rotate Trigger.rotation_count_today}}') || 0;\nconst allowed = count < max ? 1 : 0;\nreturn { allowed, rotationCount: count, maxRotations: max, reason: allowed ? 'ok' : ('budget: ' + count + '/' + max + ' rotations today') };",
          "actionType": "code/run-code"
        },
        "status": "idle"
      }
    },
    {
      "id": "budget-gate",
      "type": "action",
      "position": {"x": 504, "y": 0},
      "data": {
        "type": "action",
        "label": "Budget Gate",
        "config": {
          "condition": "{{@budget-code:Budget Check.allowed}} == 1",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "enter-gate",
      "type": "action",
      "position": {"x": 756, "y": -116},
      "data": {
        "type": "action",
        "label": "State: ENTER?",
        "config": {
          "condition": "{{@wf2-trigger:Rotate Trigger.state}} === 'ENTER'",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "spark-pre-check",
      "type": "action",
      "position": {"x": 1008, "y": -232},
      "data": {
        "type": "action",
        "label": "Pre-Check Spark",
        "config": {
          "account": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "network": "1",
          "actionType": "spark/vault-balance"
        },
        "status": "idle"
      }
    },
    {
      "id": "idem-gate",
      "type": "action",
      "position": {"x": 1260, "y": -232},
      "data": {
        "type": "action",
        "label": "Not Yet Deployed?",
        "config": {
          "condition": "{{@spark-pre-check:Pre-Check Spark.result}} == '0'",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "dai-balance",
      "type": "action",
      "position": {"x": 1512, "y": -348},
      "data": {
        "type": "action",
        "label": "Check DAI Balance",
        "config": {
          "address": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "network": "1",
          "actionType": "web3/check-token-balance",
          "tokenConfig": "{\"mode\":\"custom\",\"customToken\":{\"address\":\"0x6B175474E89094C44Da98b954EedeAC495271d0F\",\"symbol\":\"DAI\"}}"
        },
        "status": "idle"
      }
    },
    {
      "id": "approve-dai",
      "type": "action",
      "position": {"x": 1764, "y": -348},
      "data": {
        "type": "action",
        "label": "Approve DAI for Spark",
        "config": {
          "amount": "{{@dai-balance:Check DAI Balance.balance.balance}}",
          "network": "1",
          "actionType": "web3/approve-token",
          "tokenConfig": "{\"mode\":\"custom\",\"customToken\":{\"address\":\"0x6B175474E89094C44Da98b954EedeAC495271d0F\",\"symbol\":\"DAI\"}}",
          "spenderAddress": "0x83F20F44975D03b1b09e64809B757c47f942BEeA"
        },
        "status": "idle"
      }
    },
    {
      "id": "spark-deposit",
      "type": "action",
      "position": {"x": 2016, "y": -348},
      "data": {
        "type": "action",
        "label": "Deposit DAI to Spark",
        "config": {
          "assets": "{{@dai-balance:Check DAI Balance.balance.balanceRaw}}",
          "network": "1",
          "receiver": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "actionType": "spark/vault-deposit"
        },
        "status": "idle"
      }
    },
    {
      "id": "deposit-readback",
      "type": "action",
      "position": {"x": 2268, "y": -348},
      "data": {
        "type": "action",
        "label": "Verify Spark Deposit",
        "config": {
          "account": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "network": "1",
          "actionType": "spark/vault-balance"
        },
        "status": "idle"
      }
    },
    {
      "id": "exit-gate",
      "type": "action",
      "position": {"x": 1008, "y": 0},
      "data": {
        "type": "action",
        "label": "State: EXIT?",
        "config": {
          "condition": "{{@wf2-trigger:Rotate Trigger.state}} === 'EXIT'",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "spark-shares",
      "type": "action",
      "position": {"x": 1260, "y": 0},
      "data": {
        "type": "action",
        "label": "Get sDAI Shares",
        "config": {
          "account": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "network": "1",
          "actionType": "spark/vault-balance"
        },
        "status": "idle"
      }
    },
    {
      "id": "has-shares-gate",
      "type": "action",
      "position": {"x": 1512, "y": 0},
      "data": {
        "type": "action",
        "label": "Has Shares?",
        "config": {
          "condition": "{{@spark-shares:Get sDAI Shares.result}} != '0'",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "spark-redeem",
      "type": "action",
      "position": {"x": 1764, "y": -116},
      "data": {
        "type": "action",
        "label": "Redeem sDAI",
        "config": {
          "owner": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "shares": "{{@spark-shares:Get sDAI Shares.result}}",
          "network": "1",
          "receiver": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "actionType": "spark/vault-redeem"
        },
        "status": "idle"
      }
    },
    {
      "id": "dai-after",
      "type": "action",
      "position": {"x": 2016, "y": -116},
      "data": {
        "type": "action",
        "label": "Verify DAI Received",
        "config": {
          "address": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "network": "1",
          "actionType": "web3/check-token-balance",
          "tokenConfig": "{\"mode\":\"custom\",\"customToken\":{\"address\":\"0x6B175474E89094C44Da98b954EedeAC495271d0F\",\"symbol\":\"DAI\"}}"
        },
        "status": "idle"
      }
    },
    {
      "id": "aave-supply",
      "type": "action",
      "position": {"x": 2268, "y": -116},
      "data": {
        "type": "action",
        "label": "Supply DAI to Aave",
        "config": {
          "asset": "0x6B175474E89094C44Da98b954EedeAC495271d0F",
          "amount": "{{@dai-after:Verify DAI Received.balance.balanceRaw}}",
          "network": "1",
          "actionType": "aave-v3/supply",
          "onBehalfOf": "0x972A2E27b32152064F65a3Dda489F3899A168a37"
        },
        "status": "idle"
      }
    },
    {
      "id": "aave-readback",
      "type": "action",
      "position": {"x": 2520, "y": -116},
      "data": {
        "type": "action",
        "label": "Verify Aave Position",
        "config": {
          "user": "0x972A2E27b32152064F65a3Dda489F3899A168a37",
          "asset": "0x6B175474E89094C44Da98b954EedeAC495271d0F",
          "network": "1",
          "actionType": "aave-v3/get-user-reserve-data"
        },
        "status": "idle"
      }
    }
  ],
  "edges": [
    {"id": "e1", "source": "wf2-trigger", "target": "budget-code"},
    {"id": "e2", "source": "budget-code", "target": "budget-gate"},
    {"id": "e3", "source": "budget-gate", "target": "enter-gate", "sourceHandle": "true"},
    {"id": "e5", "source": "enter-gate", "target": "spark-pre-check", "sourceHandle": "true"},
    {"id": "e6", "source": "enter-gate", "target": "exit-gate", "sourceHandle": "false"},
    {"id": "e7", "source": "spark-pre-check", "target": "idem-gate"},
    {"id": "e8", "source": "idem-gate", "target": "dai-balance", "sourceHandle": "true"},
    {"id": "e10", "source": "dai-balance", "target": "approve-dai"},
    {"id": "e11", "source": "approve-dai", "target": "spark-deposit"},
    {"id": "e12", "source": "spark-deposit", "target": "deposit-readback"},
    {"id": "e14", "source": "exit-gate", "target": "spark-shares", "sourceHandle": "true"},
    {"id": "e15", "source": "spark-shares", "target": "has-shares-gate"},
    {"id": "e16", "source": "has-shares-gate", "target": "spark-redeem", "sourceHandle": "true"},
    {"id": "e18", "source": "spark-redeem", "target": "dai-after"},
    {"id": "e19", "source": "dai-after", "target": "aave-supply"},
    {"id": "e20", "source": "aave-supply", "target": "aave-readback"}
  ]
}
